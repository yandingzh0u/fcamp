{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcamp.local/schemas/largebox-discovery-result-v1.json",
  "title": "AMP Research Discovery Suite status/result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_version",
    "spec_sha256",
    "generated_at",
    "execution",
    "overall_status",
    "status_counts",
    "diagnostics",
    "decision_variables",
    "decision",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "suite_id": {"const": "largebox_discovery_v1"},
    "suite_version": {"type": "string", "minLength": 1},
    "spec_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "dry_run",
        "fail_closed",
        "spec_path",
        "output_dir",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "mode": {"enum": ["execute", "dry_run"]},
        "dry_run": {"type": "boolean"},
        "fail_closed": {"const": true},
        "spec_path": {"type": "string", "minLength": 1},
        "output_dir": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "overall_status": {"$ref": "#/$defs/diagnosticStatus"},
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "INVALID_PROTOCOL", "SKIPPED_DEPENDENCY"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "INVALID_PROTOCOL": {"type": "integer", "minimum": 0},
        "SKIPPED_DEPENDENCY": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnosticResult"}
    },
    "decision_variables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R", "T", "E", "L", "F", "X"],
      "properties": {
        "R": {"$ref": "#/$defs/decisionVariable"},
        "T": {"$ref": "#/$defs/decisionVariable"},
        "E": {"$ref": "#/$defs/decisionVariable"},
        "L": {"$ref": "#/$defs/decisionVariable"},
        "F": {"$ref": "#/$defs/decisionVariable"},
        "X": {"$ref": "#/$defs/decisionVariable"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "matched_rule_id", "selected_family", "reason"],
      "properties": {
        "status": {"enum": ["DEFERRED", "SELECTED", "NO_ELIGIBLE_FAMILY"]},
        "matched_rule_id": {"type": ["string", "null"]},
        "selected_family": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "status",
        "checkpoint_inventory",
        "canonical_rollout_index",
        "policy_class_gate",
        "domain_triangle_gate",
        "reward_validity_gate",
        "edge_gate",
        "family_decision_matrix",
        "discovery_report",
        "diagnostic_results",
        "source_and_logs"
      ],
      "properties": {
        "manifest": {"$ref": "#/$defs/nullablePath"},
        "status": {"$ref": "#/$defs/nullablePath"},
        "checkpoint_inventory": {"$ref": "#/$defs/nullablePath"},
        "canonical_rollout_index": {"$ref": "#/$defs/nullablePath"},
        "policy_class_gate": {"$ref": "#/$defs/nullablePath"},
        "domain_triangle_gate": {"$ref": "#/$defs/nullablePath"},
        "reward_validity_gate": {"$ref": "#/$defs/nullablePath"},
        "edge_gate": {"$ref": "#/$defs/nullablePath"},
        "family_decision_matrix": {"$ref": "#/$defs/nullablePath"},
        "discovery_report": {"$ref": "#/$defs/nullablePath"},
        "diagnostic_results": {"$ref": "#/$defs/nullablePath"},
        "source_and_logs": {"$ref": "#/$defs/nullablePath"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "nullablePath": {"type": ["string", "null"]},
    "diagnosticStatus": {
      "enum": ["PASS", "FAIL", "INVALID_PROTOCOL", "SKIPPED_DEPENDENCY"]
    },
    "decisionVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_diagnostics", "reason"],
      "properties": {
        "value": {"enum": ["+", "-", "UNKNOWN"]},
        "evidence_diagnostics": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{2}$"},
          "uniqueItems": true
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "diagnosticResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "name",
        "stage",
        "status",
        "dependencies",
        "command",
        "required",
        "blocking",
        "reason",
        "started_at",
        "finished_at",
        "duration_seconds",
        "exit_code",
        "expected_outputs",
        "observed_outputs",
        "status_artifact",
        "stdout_log",
        "stderr_log",
        "metadata"
      ],
      "properties": {
        "diagnostic_id": {"type": "string", "pattern": "^[0-9]{2}$"},
        "name": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/diagnosticStatus"},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{2}$"},
          "uniqueItems": true
        },
        "command": {"type": "array", "items": {"type": "string"}},
        "required": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "expected_outputs": {"type": "array", "items": {"type": "string"}},
        "observed_outputs": {"type": "array", "items": {"type": "string"}},
        "status_artifact": {"type": ["string", "null"]},
        "stdout_log": {"type": ["string", "null"]},
        "stderr_log": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    }
  }
}
